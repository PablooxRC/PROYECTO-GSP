# ============================================================
# Variables de entorno para Docker (producción)
# Copia este archivo como .env.docker y rellena los valores
# NUNCA subas .env.docker al repositorio
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Puerto público de la aplicación (nginx)
APP_PORT=80

# ── Base de datos ─────────────────────────────────────────────
DB_HOST=postgres        # nombre del servicio en docker-compose
DB_PORT=5432
DB_NAME=Scouts
DB_USER=scouts_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
DB_MAX_CONNECTIONS=10

# ── JWT ───────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_MINIMO_32_CHARS
JWT_EXPIRATION=24h

# ── CORS (si expones el backend en otro dominio) ───────────────
# Puede ser una lista separada por comas: http://dominio1.com,https://dominio2.com
# En Docker con nginx como proxy, normalmente no hace falta cambiar esto
CORS_ORIGIN=http://localhost

# ── SMTP (nodemailer) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
FROM_EMAIL=tu_correo@gmail.com

# Alternativa: Resend API key
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Frontend (nombre de la app) ───────────────────────────────
VITE_APP_NAME=GSP
